# 复制为 .env 后填写；.env 已被 .gitignore 排除，不要提交
# provider: auto | cloud | local | rules
#   auto = 有云端 key 走云端，否则探测本地 Ollama，都不行走规则兜底
AI_PROVIDER=auto

# 云端（默认智谱，glm-4-flash 为免费档）
AI_CLOUD_API_KEY=
AI_CLOUD_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_CLOUD_CHAT_MODEL=glm-4-flash

# 本地 Ollama（可选，需先 ollama serve）
AI_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AI_LOCAL_CHAT_MODEL=qwen2.5:7b

# 生成参数
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=800
AI_TIMEOUT=30

# 会话持久化（P5-2）：Redis 不可用时自动退回内存检查点（重启丢历史）
AI_REDIS_URL=redis://127.0.0.1:6379/0
AI_CHECKPOINT_TTL=7200
